\f0\fs24 \cf0 /* Color Palette & Fonts */\
:root \{\
    --warm-white: #FAFAFA;\
    --crust-brown: #5C4033;\
    --golden-peach: #E59866;\
    --charcoal: #333333;\
\}\
\
body \{\
    font-family: 'Lato', sans-serif;\
    color: var(--charcoal);\
    background-color: var(--warm-white);\
    margin: 0;\
    padding: 0;\
\}\
\
h1, h2, legend \{\
    font-family: 'Merriweather', serif;\
    color: var(--crust-brown);\
\}\
\
/* Mobile-First Flexbox Layout */\
header, nav ul \{\
    display: flex;\
    flex-direction: column;\
    align-items: center;\
    background-color: var(--golden-peach);\
    padding: 1rem;\
\}\
\
nav ul \{\
    list-style: none;\
    padding: 0;\
    gap: 15px;\
\}\
\
nav a \{\
    text-decoration: none;\
    color: var(--crust-brown);\
    font-weight: bold;\
\}\
\
/* Form Styling */\
fieldset \{\
    display: flex;\
    flex-direction: column;\
    gap: 10px;\
    border: 2px solid var(--crust-brown);\
\}\
\
/* Responsive Images for the Screenshot */\
img, picture \{\
    max-width: 100%;\
    height: auto;\
    border-radius: 8px;\
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);\
\}\
\
figure \{\
    background-color: var(--warm-white);\
    border: 2px solid var(--golden-peach);\
    padding: 15px;\
    margin: 20px auto;\
    text-align: center;\
    border-radius: 8px;\
    max-width: 600px;\
\}\
\
figcaption \{\
    font-family: 'Lato', sans-serif;\
    color: var(--crust-brown);\
    font-style: italic;\
    font-weight: bold;\
    margin-top: 10px;\
\}\
\
/* Media Query for Larger Screens */\
@media (min-width: 768px) \{\
    nav ul \{\
        flex-direction: row;\
        gap: 30px;\
    \}\
    \
    main \{\
        padding: 2rem 15%;\
    \}\
\}}